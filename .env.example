DATABASE_URL=sqlite:///./railblox.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SOLVE_SECONDS=10
VITE_API_URL=http://127.0.0.1:8000
APP_ENV=development
AUTH_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only Supabase secret for the Admin user access page. Never expose this to Vite/browser code.
SUPABASE_SERVICE_ROLE_KEY=
DEPLOYMENT_DIVISION=prototype
SEED_DEMO=true
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DATA_POLICY=disabled
AI_DAILY_CALL_LIMIT=50
# Local prototype settings. Production defaults to invitation-only and no birth-date collection.
PUBLIC_SIGNUP_ENABLED=true
COLLECT_DATE_OF_BIRTH=true
# Production always enforces MFA for Planner, Officer and Admin.
REQUIRE_MFA=false
API_RATE_LIMIT_PER_MINUTE=240
