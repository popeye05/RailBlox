APP_ENV=production
AUTH_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SIGNUP_ENABLED=false
COLLECT_DATE_OF_BIRTH=false
REQUIRE_MFA=true
API_RATE_LIMIT_PER_MINUTE=240
DEPLOYMENT_DIVISION=prototype
CORS_ORIGINS=https://YOUR-APP-DOMAIN
# Supabase Connect > direct connection or session pooler (not transaction pooler).
# URL-encode the database password. Use the Supabase CA via sslrootcert if required.
DATABASE_URL=postgresql+psycopg://railblox_app:REPLACE_ME@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=verify-full
SOLVE_SECONDS=10
# Explicitly allow synthetic fixtures for the deployed prototype.
SEED_DEMO=true
# Optional; never prefix secrets with VITE_. No AI requests until configured.
AI_DATA_POLICY=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_CALL_LIMIT=50
